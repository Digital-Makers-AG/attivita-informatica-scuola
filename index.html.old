\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003elbl\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eIstruzioni\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003epre\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003ecopybox\u003c/span\u003e\u0026quot; \u003cspan class=pl-c1\u003eid\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003ed09\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eMissione 0 conclusa! Ora confronta il prima e il dopo.","","1. Apri il TUO passaporto della Consegna 00 (Classroom \u0026amp;gt; Consegna 00 \u0026amp;gt; il tuo documento, oppure Drive \u0026amp;gt; Classroom \u0026amp;gt; cartella della classe).","2. Compila le colonne DOPO e, per ogni riga, la colonna \u0026amp;quot;Una prova\u0026amp;quot;: quando l\u0026amp;#x27;hai fatto davvero?","3. Compila la pagina finale.","4. Qui premi Aggiungi o crea \u0026amp;gt; Google Drive, scegli il tuo passaporto e premi CONSEGNA.\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003epre\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ebutton\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003ecp\u003c/span\u003e\u0026quot; \u003cspan class=pl-c1\u003edata-target\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003ed09\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eCopia\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ebutton\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003estep\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003esn\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e2\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003esb\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003eh4\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eNessun allegato\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003eh4\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ep\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eGli studenti riallegano il loro passaporto della Consegna 00 (\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003eb\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eAggiungi o crea › Google Drive\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003eb\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e).\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ep\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003estep\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003esn\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e3\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ediv\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003esb\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003eh4\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eChe cosa consegnano gli studenti\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003eh4\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ep\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eLo stesso passaporto della Consegna 00, con le colonne DOPO, \u0026amp;#x27;Una prova\u0026amp;#x27; e la pagina finale compilate.\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ep\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e","\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ep\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003esmall\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003eb\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003eCome controlli:\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003eb\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e Confrontate PRIMA e DOPO con il registro delle osservazioni: dove lo studente si vede \u0026amp;#x27;verde\u0026amp;#x27; ma la griglia dice \u0026amp;#x27;con supporto\u0026amp;#x27;, parlatene con lui (autovalutazione).\u003cspan class=pl-kos\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=pl-ent\u003ep\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026gt;\u003c/span\u003e\u003cspan class=pl-kos\u003e\u0026lt;\u003c/span\u003e\u003cspan class=pl-ent\u003ep\u003c/span\u003e \u003cspan class=pl-c1\u003eclass\u003c/span\u003e=\u0026quot;\u003cspan class=pl-s\u003esmall\u003c/span\u003e\u0026quot;\u003cspan class=pl-kos\u003e\u0026gt;\u003c/