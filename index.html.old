16px;line-height:1.5}","a{color:var(--teal-d)} .hero{background:linear-gradient(135deg,var(--teal) 0%,var(--teal-d) 100%);color:#fff;padding:34px 24px 28px}",".hero .in{max-width:1180px;margin:0 auto} .hero h1{margin:4px 0 6px;font-size:clamp(26px,4vw,40px);line-height:1.15} .hero p{margin:0;max-width:760px;opacity:.95}",".pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px} .pills span{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:20px;padding:4px 12px;font-size:14px}",".wrap{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:220px 1fr;gap:28px;padding:24px}","nav.side{position:sticky;top:16px;align-self:start;display:flex;flex-direction:column;gap:2px} nav.side a{text-decoration:none;color:var(--ink);padding:8px 12px;border-radius:8px;font-size:15px}","nav.side a:hover{background:var(--teal-l)} nav.side a.on{background:var(--teal);color:#fff}",".prog{margin-top:12px;font-size:13px;color:var(--muted);padding:0 12px} .bar{height:6px;background:#e5e9ec;border-radius:4px;overflow:hidden;margin-top:4px} .bar div{height:100%;background:var(--orange);width:0}","section{margin-bottom:44px;scroll-margin-top:12px} h2{font-size:28px;margin:2px 0 12px;color:var(--teal-d)} h3{margin:0;font-size:20px} h4{margin:0 0 8px;font-size:16px}",".kicker{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--orange);font-weight:700}",".card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px} .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px} .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}",".docs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:14px 0} .doc{display:flex;flex-direction:column;gap:4px;text-decoration:none;background:#fff;border:1px solid var(--line);border-left:5px solid var(--orange);border-radius:10px;padding:12px 14px;color:var(--ink)}",".doc:hover{border-color:var(--orange)} .doc span{font-size:13px;color:var(--muted)}",".task{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin-bottom:18px;box-shadow:0 1px 2px rgba(0,0,0,.04)}",".taskhead{display:flex;gap:14px;align-items:center} .num-badge{flex:none;width:46px;height:46px;border-radius:12px;background:var(--teal);color:#fff;font-weight:800;font-size:18px;display:grid;place-items:center}",".done{margin-left:auto;font-size:14px;color:var(--muted);white-space:nowrap} .when{color:var(--muted);margin:10px 0 4px;font-size:15px}",".step{display:grid;grid-template-columns:30px 1fr;gap:12px;margin-top:16px} .sn{width:28px;height:28px;border-radius:50%;background:var(--orange-l);color:var(--orange);font-weight:800;display:grid;place-items:center}",".small{font-size:14px;color:var(--muted)} .tiny{font-size:12.5px;color:var(--muted)}",".copyrow{display:grid;grid-template-columns:90px 1fr auto;gap:10px;align-items:start;margin:8px 0} .lbl{font-weight:700;font-size:14px;padding-top:9px}",".copybox{margin:0;background:#f4f6f7;border:1px solid var(--line);border-radius:8px;padding:9px 12px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;white-space:pre-wrap;word-break:break-word}","button{font:inherit;cursor:pointer} .cp{background:var(--teal);color:#fff;border:0;border-radius:8px;padding:8px 14px;font-size:14px} .cp.ok{background:#1e7d3a}",".all{margin-top:10px;background:#fff;border:2px solid var(--teal);color:var(--teal-d);border-radius:8px;padding:8px 14px;font-weight:600}",".tw{overflow-x:auto} table{border-collapse:collapse;width:100%;font-size:14.5px} th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top} th{font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}","td.num{white-space:nowrap;color:var(--muted)} td.note{color:var(--muted);font-size:13.5px} a.dl{font-weight:600;text-decoration:none} a.dl:hover{text-decoration:underline}",".b{display:inline-block;border-radius:12px;padding:2px 10px;font-size:12.5px;font-weight:700;white-space:nowrap} .b.copy{background:var(--orange-l);color:#9a4410} .b.view{background:var(--teal-l);color:var(--teal-d)}","table.mini td{padding:5px 8px} ul{padding-left:20px;margin:6px 0} ul.checks{list-style:none;padding-left:0} ul.checks li{margin:4px 0}","details{background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px 16px;margin:10px 0} summary{cursor:pointer;font-weight:700} details.sol{border-left:5px solid #7a4bb5} details.bes{border-left:5px solid var(--teal);margin-top:16px}",".try{display:inline-block;margin:10px 8px 0 0;background:var(--orange);color:#fff;text-decoration:none;border-radius:8px;padding:7px 12px;font-size:14px;font-weight:600}",".warn{background:#fff7e6;border:1px solid #f0c36d;border-radius:12px;padding:14px 18px} ol.big li{margin:8px 0}","footer{text-align:center;color:var(--muted);font-size:13px;padding:30px}","main{min-width:0} a.dl,td a,.doc b{overflow-wrap:anywhere} .copybox{min-width:0;overflow-wrap:anywhere}","@media(max-width:900px){.wrap{grid-template-columns:minmax(0,1fr);padding:16px} nav.side{position:static;flex-direction:row;flex-wrap:wrap;min-width:0} nav.side a{padding:6px 10px;font-size:14px}",".grid2,.grid3,.docs{grid-template-columns:minmax(0,1fr)} .copyrow{grid-template-columns:minmax(0,1fr)} .done{display:none} .prog{width:100%}","table{font-size:13.5px} th:nth-child(4),td.note{display:none} .task,.card{padding:14px}}","@media print{nav.side,.cp,.all,.try,.done{display:none} .wrap{display:block} details{border:0} details\u003e*{display:block}}","\u003c/style\u003e\u003c/head\u003e\u003cbody\u003e","\u003cheader class=\"hero\"\u003e\u003cdiv class=\"in\"\u003e\u003cdiv class=\"kicker\" style=\"color:#ffd9bf\"\u003eGuida per il docente\u003c/div\u003e","\u003ch1\u003eMissione 0 – Riattiviamo le competenze digitali\u003c/h1\u003e","\u003cp\u003eQuattro lezioni pratiche e una missione finale per riattivare le competenze informatiche del biennio. Gli studenti fanno gli stagisti digitali di \u003cb\u003eOfficina 23\u003c/b\u003e, una bottega di biciclette inventata, e lavorano su file veri. Questa pagina ti guida passo passo: che cosa si fa in ogni lezione, quali file scaricare, che compito creare in Classroom.\u003c/p\u003e","\u003cdiv class=\"pills\"\u003e\u003cspan\u003e4 lezioni da 2 ore + missione finale\u003c/span\u003e\u003cspan\u003eGoogle Workspace for Education\u003c/span\u003e\u003cspan\u003eVersioni BES per ogni attività\u003c/span\u003e\u003ca href=\"sintesi.html\" style=\"background:#fff;color:#0B6E75;font-weight:700;text-decoration:none;border-radius:999px;padding:4px 12px\"\u003eSintesi per i colleghi →\u003c/a\u003e\u003ca href=\"verifica_codici.html\" style=\"background:#fff;color:#0B6E75;font-weight:700;text-decoration:none;border-radius:999px;padding:4px 12px\"\u003eVerifica codici →\u003c/a\u003e\u003c/div\u003e\u003c/div\u003e\u003c/header\u003e","\u003cdiv class=\"wrap\"\u003e\u003cnav class=\"side\" id=\"side\"\u003e\u003ca href=\"#inizio\"\u003eInizia qui\u003c/a\u003e\u003ca href=\"#prepara\"\u003ePrepara Classroom\u003c/a\u003e\u003ca href=\"#l1\"\u003eLezione 1\u003c/a\u003e\u003ca href=\"#l2\"\u003eLezione 2\u003c/a\u003e\u003ca href=\"#l3\"\u003eLezione 3\u003c/a\u003e\u003ca href=\"#l4\"\u003eLezione 4\u003c/a\u003e\u003ca href=\"#mf\"\u003eMissione finale\u003c/a\u003e\u003ca href=\"#valutazione\"\u003eValutazione\u003c/a\u003e\u003ca href=\"#bes\"\u003eBES / DSA\u003c/a\u003e\u003ca href=\"#archivio\"\u003eTutti i file\u003c/a\u003e\u003cdiv class=\"prog\"\u003ePreparazione: \u003cspan id=\"pc\"\u003e0\u003c/span\u003e fatto\u003cdiv class=\"bar\"\u003e\u003cdiv id=\"pb\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/nav\u003e","\u003cmain\u003e","\u003csection id=\"inizio\"\u003e\u003cdiv class=\"kicker\"\u003eInizia qui\u003c/div\u003e\u003ch2\u003eCome funziona\u003c/h2\u003e","\u003cdiv class=\"grid3\"\u003e\u003cdiv class=\"card\"\u003e\u003ch4\u003e🎯 L'obiettivo\u003c/h4\u003e\u003cp\u003eRiportare gli studenti a usare con sicurezza e in autonomia tastiera, file, documenti, ricerca, immagini, Drive, Gmail e sicurezza. Niente verifiche né quiz: si osserva ciò che producono (file, link, email).\u003c/p\u003e\u003c/div\u003e","\u003cdiv class=\"card\"\u003e\u003ch4\u003e🚲 Il filo conduttore\u003c/h4\u003e\u003cp\u003eUn unico scenario: la chiavetta disordinata di Marta (L1), la scheda del noleggio da sistemare (L2), fonti e immagini (L3), i file alla tipografia e le email truffa (L4), la proposta per il Comune (missione finale).\u003c/p\u003e\u003c/div\u003e","\u003cdiv class=\"card\"\u003e\u003ch4\u003e🪜 Dalla guida all'autonomia\u003c/h4\u003e\u003cp\u003eLa Lezione 1 ha passi numerati; poi obiettivi e criteri; la missione finale dà solo scenario, obiettivo, artefatti e vincoli, per vedere se gli studenti sanno trasferire.\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e","\u003cdiv class=\"docs\"\u003e\u003ca class=\"doc\" href=\"00_GUIDA_DOCENTE/GUIDA_DOCENTE_MISSIONE_0.docx\" download\u003e\u003cb\u003e⬇ Guida completa per il docente\u003c/b\u003e\u003cspan\u003epasso passo, circa 6.300 parole · 60 KB\u003c/span\u003e\u003c/a\u003e\u003ca class=\"doc\" href=\"00_GUIDA_DOCENTE/SCALETTA_RAPIDA_da_stampare.docx\" download\u003e\u003cb\u003e⬇ Scaletta rapida\u003c/b\u003e\u003cspan\u003euna pagina da tenere sulla cattedra · 38 KB\u003c/span\u003e\u003c/a\u003e\u003ca class=\"doc\" href=\"README/README_DOCENTE.docx\" download\u003e\u003cb\u003e⬇ README\u003c/b\u003e\u003cspan\u003enumeri, formati, limiti del pacchetto · 44 KB\u003c/span\u003e\u003c/a\u003e\u003ca class=\"doc\" href=\"08_CLASSROOM_CONSEGNE/00_LEGGIMI_ORDINE_DI_CARICAMENTO.docx\" download\u003e\u003cb\u003e⬇ Ordine di caricamento in Classroom\u003c/b\u003e\u003cspan\u003eversione stampabile di questa pagina · 40 KB\u003c/span\u003e\u003c/a\u003e\u003c/div\u003e","\u003cdiv class=\"card\"\u003e\u003ch4\u003eTi serve\u003c/h4\u003e\u003cul\u003e\u003cli\u003eUn laboratorio con un PC per studente (o per coppia), Windows con Chrome, proiettore.\u003c/li\u003e\u003cli\u003eAccount Google della scuola per gli studenti con Classroom, Drive e Gmail attivi.\u003c/li\u003e\u003cli\u003eCirca 2 ore la prima volta per preparare Classroom (sezione successiva) e 30 minuti di prova tecnica.\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\u003c/section\u003e","","\u003csection id=\"prepara\"\u003e\u003cdiv class=\"kicker\"\u003eUna volta sola\u003c/div\u003e\u003ch2\u003ePrepara Classroom\u003c/h2\u003e","\u003col class=\"big\"\u003e\u003cli\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" data-k=\"p1\"\u003e Nel corso crea l'argomento \u003cb\u003eMissione 0 – Officina 23\u003c/b\u003e (Lavori del corso › + Crea › Argomento).\u003c/label\u003e\u003c/li\u003e","\u003cli\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" data-k=\"p2\"\u003e Scarica i documenti che gli studenti compileranno (elenco sotto), caricali in Drive e per ognuno: doppio clic › \u003cb\u003eApri con › Documenti Google\u003c/b\u003e › \u003cb\u003eFile › Salva come Documento Google\u003c/b\u003e. Sposta poi i .docx originali in una cartella \u003cb\u003eORIGINALI\u003c/b\u003e.\u003c/label\u003e\u003c/li\u003e","\u003cli\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" data-k=\"p3\"\u003e Apri una volta il documento di Marta convertito (Lezione 2): logo ovale e tabella con celle vuote devono vedersi.\u003c/label\u003e\u003c/li\u003e","\u003cli\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" data-k=\"p4\"\u003e Fai la prova tecnica su un PC del laboratorio: strumenti HTML, estrazione di uno ZIP, Cestino, email e condivisione Drive da un account studente (dettagli nella Guida, sezione 4).\u003c/label\u003e\u003c/li\u003e","\u003cli\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" data-k=\"p6\"\u003e Crea il Modulo Google «Missione 0 · codici risultato» e allegalo ai compiti 01, 03, 06 e 08: domande e impostazioni sono nella pagina \u003ca href=\"verifica_codici.html\"\u003eVerifica codici\u003c/a\u003e.\u003c/label\u003e\u003c/li\u003e","\u003cli\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" data-k=\"p5\"\u003e Crea i compiti seguendo le lezioni qui sotto. Puoi crearli tutti subito e \u003cb\u003eprogrammarli\u003c/b\u003e (freccia accanto ad Assegna › Programma).\u003c/label\u003e\u003c/li\u003e\u003c/ol\u003e","\u003cdetails\u003e\u003csummary\u003e📄 Documenti da convertire in Documenti Google (25)\u003c/summary\u003e\u003cul\u003e\u003cli\u003e\u003ca href=\"01_LEZIONE_1/BES/L1_A_scheda_tastiera_shortcut_CHECKLIST.docx\" download\u003e⬇ L1_A_scheda_tastiera_shortcut_CHECKLIST.docx\u003c/a\u003e \u003cspan class=\"tiny\"\u003e01_LEZIONE_1\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"01_LEZIONE_1/BES/L1_B_scheda_file_cartelle_dimensioni_CHECKLIST.docx\" download\u003e⬇ L1_B_scheda_file_cartelle_dimensioni_CHECKLIST.docx\u003c/a\u003e \u003cspan class=\"tiny\"\u003e01_LEZIONE_1\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"01_LEZIONE_1/BES/L1_B_scheda_file_cartelle_dimensioni_GUIDATA.docx\" download\u003e⬇ L1_B_scheda_file_cartelle_dimensioni_GUIDATA.docx\u003c/a\u003e \u003cspan class=\"tiny\"\u003e01_LEZIONE_1\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"01_LEZIONE_1/STANDARD/L1_A_scheda_tastiera_shortcut.docx\" download\u003e⬇ L1_A_scheda_tastiera_shortcut.docx\u003c/a\u003e \u003cspan class=\"tiny\"\u003e01_LEZIONE_1\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"01_LEZIONE_1/STANDARD/L1_B_scheda_file_cartelle_dimensioni.docx\" download\u003e⬇ L1_B_scheda_file_cartelle_dimensioni.docx\u003c/a\u003e \u003cspan class=\"tiny\"\u003e01_LEZIONE_1\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"02_LEZIONE_2/BES/L2_scheda_sistema_documento_CHECKLIST.docx\" download\u003e⬇ L2_scheda_sistema_documento_CHECKLIST.docx\u003c/a\u003e \u003cspan class=\"tiny\"\u003e02_LEZIONE_2\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"02_LEZIONE_2/BES/L2_sched